# Internal Prism: a starting point. Copy this to a private file (not committed),
# fill in the blanks, then deploy with:
#   ./deploy.sh --config deploy/internal.env
# Same code as llm-d Prism; its own URL, data and sign-in. See
# specs/changes/prism-instances/design.md.

PROJECT_ID=""                       # your GCP project
SERVICE_NAME="prism-internal"
REGION="us-central1"

# Which Prism this is (src/config/site.js)
PRISM_INSTANCE="internal"           # approvers mark results Official, others request it; nothing is made public
PRISM_BRAND="prism"                 # Prism's own mark; only llm-d Prism uses llm-d's logo
SITE_NAME="Google Cloud"            # shown next to the mark and in the tab: "Prism · Google Cloud"
PRISM_PINNED_REPORTS=""             # e.g. "agentic-serving inference-scheduling"; empty pins every built-in report

# Data
GCS_BUCKETS=""                      # this instance's own results bucket(s)
GIQ_PROJECTS=""

# Who approves. Approvers are the GitHub handles listed, one per line, in
#   gs://<first bucket in GCS_BUCKETS>/prism-iam/github-admin-allowlist.txt
# (contributors: prism-iam/github-user-allowlist.txt). llm-d's org admins are
# NOT approvers here unless you name an org below (server/oauth.ts).
PRISM_GITHUB_ADMIN_ORG=""           # optional: a GitHub org whose admins also approve

# Who can get in. "false" makes Cloud Run require an authenticated Google
# identity with the run.invoker role on every request, which a browser doesn't
# send by itself, so on its own it locks people out rather than asking them to
# sign in. Put Identity-Aware Proxy (IAP) or a load balancer with IAP in front
# of the service and grant your users access there. GitHub sign-in inside Prism
# only records who uploaded, asked and approved; it doesn't keep anyone out.
ALLOW_UNAUTHENTICATED="false"
PUBLIC_URL=""                       # this instance's URL (the IAP / load balancer one), for the GitHub OAuth callback
CONTACT_US_URL=""

# deploy.sh defaults to llm-d's analytics property; keep internal traffic out of it.
GA_TRACKING_ID=""

MIN_INSTANCES="0"
MAX_INSTANCES="10"
CONCURRENCY="80"
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID:-""}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET:-""}
